{
  "name": "skycast",
  "version": "2.0.0",
  "private": true,
  "description": "SkyCast - real-time weather, satellite, atmosphere and Earth intelligence platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "pages:deploy": "npx wrangler@latest pages deploy dist --project-name skycast",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "weather",
    "radar",
    "satellite",
    "earth-observation",
    "air-quality",
    "map"
  ],
  "dependencies": {  },
  "devDependencies": {}
}
