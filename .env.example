# =============================================================================
# SkyCast - environment configuration
# =============================================================================
# Copy this file to `.env` and fill in only what you need:
#
#     cp .env.example .env
#
# NEVER commit `.env`. It is git-ignored. Every value here is read by the
# server only; no secret is ever sent to the browser.
#
# IMPORTANT - Current weather and live news require their server-side keys.
# Other features use the following keyless providers where available:
#
#   weather                                -> OpenWeather
#   forecast / 15-min nowcast              -> Open-Meteo
#   air quality                          -> Open-Meteo Air Quality
#   ocean waves + sea surface temp        -> Open-Meteo Marine
#   radar + weather map layers           -> OpenWeather Maps
#   satellite + Earth imagery             -> NASA GIBS (EOSDIS)
#   earthquakes                           -> USGS
#   tropical cyclones / hurricane tracks  -> NOAA NHC
#   global disaster alerts                -> GDACS
#   US severe weather alerts              -> NOAA/NWS
#   wildfires / storms / volcanoes        -> NASA EONET
#   location-aware news                   -> GNews
#
# Set the OpenWeather and GNews keys below for live current weather and news.
# Leave other optional keys blank to keep using the keyless defaults.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port and interface for the SkyCast server. Hosted services should bind to
# 0.0.0.0 (HOST) and use the platform-provided PORT.
PORT=3000
HOST=127.0.0.1

# Contact string sent as User-Agent to upstream providers.
# Some official APIs (notably api.weather.gov) require a real contact address
# in the User-Agent and will return 403 without one. Please set your own.
SKYCAST_CONTACT=you@example.com

# Runtime environment: development | production
NODE_ENV=development

# Redirect HTTP requests to HTTPS when running behind a TLS terminator or in
# production. Leave false for local dev.
FORCE_HTTPS=false

# -----------------------------------------------------------------------------
# Provider selection
# -----------------------------------------------------------------------------
# GNews is used server-side for verified English news.

# Map basemap provider. `carto` (default), `osm` and `esri` need no key.
# `maptiler` requires MAP_API_KEY below.
MAP_PROVIDER=carto


# -----------------------------------------------------------------------------
# Optional API keys
# -----------------------------------------------------------------------------
# For Cloudflare Pages, add provider keys as encrypted Secrets under the
# Pages project's Settings > Environment variables instead of storing them in
# frontend code or repository files.
# Optional OpenWeather map tiles. The key stays server-side and is never sent
# to browser JavaScript. Official weather alerts use NOAA/NWS without a key.
OPENWEATHER_API_KEY=

# MapTiler - unlocks vector basemap styles and the terrain-DEM basemap.
# Get one at: https://cloud.maptiler.com/account/keys/
MAP_API_KEY=

# GNews. Required for live news. Never put this value in browser JavaScript or
# commit it to the repository. On Cloudflare Pages, use an encrypted Secret.
# Get one at: https://gnews.io/
GNEWS_API_KEY=

# Satellite imagery. NASA GIBS requires no key, so this is normally blank.
# It exists so a future commercial satellite provider can be dropped in
# without a code change.
SATELLITE_API_KEY=

# NASA FIRMS - unlocks near-real-time satellite fire detections (VIIRS 375m).
# Keyless alternative already enabled: NASA EONET wildfires.
# Get one at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=


# -----------------------------------------------------------------------------
# Refresh strategy (seconds)
# -----------------------------------------------------------------------------
# SkyCast polls each provider at its own documented cadence instead of
# hammering every endpoint. Values are the minimum age of a cached entry
# before it is refreshed.
CACHE_TTL_WEATHER=300
CACHE_TTL_FORECAST=900
CACHE_TTL_AIR_QUALITY=1800
CACHE_TTL_RADAR=120
CACHE_TTL_SATELLITE_METADATA=3600
CACHE_TTL_EARTHQUAKES=120
CACHE_TTL_ALERTS=300
CACHE_TTL_STORMS=900
CACHE_TTL_FIRES=900
CACHE_TTL_NEWS=600
CACHE_TTL_GEOCODE=86400
CACHE_TTL_OCEAN=1800

# When an upstream provider fails, SkyCast may serve the last good response
# for up to this many seconds, clearly labelled as stale. 0 disables it.
CACHE_STALE_MAX_AGE=21600

# Upstream request timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=12000

# Retry policy for transient upstream failures (429/5xx/network).
UPSTREAM_MAX_RETRIES=2
UPSTREAM_BACKOFF_BASE_MS=400


# -----------------------------------------------------------------------------
# Abuse protection
# -----------------------------------------------------------------------------
# Requests per minute per IP against the local /api routes.
RATE_LIMIT_PER_MINUTE=240

# Set to `true` to answer API routes with cached data only (never contacts an
# upstream provider). Useful for offline demos and for CI.
OFFLINE_MODE=false
